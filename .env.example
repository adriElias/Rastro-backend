# Project
COMPOSE_PROJECT_NAME=rastro

# JWT
# Replace this placeholder with a securely generated random secret of at least 32 UTF-8 bytes.
# Base64-encoded cryptographically random key (minimum 32 decoded bytes).
# Generate your own key: openssl rand -base64 32
JWT_SECRET=replace_with_your_base64_encoded_random_key
JWT_ISSUER=rastro-backend
JWT_ACCESS_TOKEN_TTL_SECONDS=900

# PostgreSQL
POSTGRES_DB=animal_reports
POSTGRES_USER=animal_user
POSTGRES_PASSWORD=replace_with_your_secure_password
POSTGRES_PORT=5432

# Adminer
ADMINER_PORT=8080
